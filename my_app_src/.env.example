# ========== Flask ==========
# development / production
# exe 打包后 sys.frozen=True 时会自动强制生产模式，此值对打包无效
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_PORT=5000
SECRET_KEY=change-me-flask-secret

# ========== MySQL（曲线数据入库与读取的唯一来源） ==========
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=change-me
DB_NAME=power_tool

# ========== JWT ==========
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRE_HOURS=24

# ========== 上传限制（MB） ==========
MAX_UPLOAD_MB=50

# ========== WPS 云盘同步 ==========
# 开发模式默认不启动同步，设为 true 可强制启用
SYNC_ENABLED=false