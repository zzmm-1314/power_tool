# ========== Flask ==========
# development / production；打包后（frozen）会自动强制生产，此值失效
FLASK_ENV=production
FLASK_DEBUG=false
FLASK_PORT=5000
SECRET_KEY=change-me-flask-secret

# ========== MySQL · 江苏业务库（t_bid_space，浙江省数据） ==========
JS_DB_HOST=change-me
JS_DB_PORT=13307
JS_DB_USER=root
JS_DB_PASS=change-me
JS_DB_NAME=power_js

# ========== MySQL · 浙江临时库（tmp_* 表，存放上传解析结果） ==========
ZJ_DB_HOST=change-me
ZJ_DB_PORT=13306
ZJ_DB_USER=root
ZJ_DB_PASS=change-me
ZJ_DB_NAME=power_zj

# 连接禁用 SSL（内网/阿里云 MySQL 通常需要）
SSL_DISABLED=true

# ========== JWT ==========
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRE_HOURS=24

# ========== 上传限制（MB） ==========
MAX_UPLOAD_MB=50

# ========== 日志 ==========
POWER_TOOL_LOG_LEVEL=INFO
POWER_TOOL_LOG_FILE=